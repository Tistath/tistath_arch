iwctl   //进入网络组件

station wlan0 connect "wifi名"  //连wifi

输入密码

exit    //退出网络组件

ip a    //检查网络连接，如果有地址输出则为成功

timedatectl set-ntp true        //同步时间

lsblk -pf       //查看设备名

cfdisk /dev/nvme0n1     //硬盘分区

用上下选择区，用左右选择delete删除所有区

选择new，大小1g，选择type，类型EFI system       //创建启动分区

选择new，大小为剩余大小，选择write，yes //创建根分区

选择quit        //退出

lsblk -pf       //验证

mkfs.fat -F 32 /dev/nvme0n1p1   //格式化启动分区

mkfs.btrfs -f /dev/nvme0n1p2    //格式化(并清除)根分区

mount -t btrfs -o compress=zstd /dev/nvme0n1p2 /mnt     //挂载根分区

btrfs subvolume create /mnt/@   //创建子卷

btrfs subvolume create /mnt/@home

btrfs subvolume create /mnt/@swap

umount /mnt     //取消挂载

mount -t btrfs -o subvol=/@,compress=zstd /dev/nvme0n1p2 /mnt

mount --mkdir -t btrfs -o subvol=/@home,compress=zstd /dev/nvme0n1p2 /mnt/home

mount --mkdir -t btrfs -o subvol=/@swap,compress=zstd /dev/nvme0n1p2 /mnt/swap

mount --mkdir /dev/nvme0n1p1 /mnt/boot  //挂载

df -h   //检查

pacman -Sy archlinux-keyring    //安装密钥

vim /etc/pacman.d/mirrorlist

添加arch Linux中国镜像源

Server = https://mirrors.ustc.edu.cn/archlinux/$repo/os/$arch
Server = https://mirrors.tuna.tsinghua.edu.cn/archlinux/$repo/os/$arch
Server = https://mirrors.aliyun.com/archlinux/$repo/os/$arch

pacstrap -K /mnt base base-devel linux linux-firmware btrfs-progs       //复制密钥并安装基本包

pacstrap /mnt networkmanager neovim amd-ucode   //安装必要软件包

btrfs filesystem mkswapfile --size 8g --uuid clear /mnt/swap/swapfile大小按指南分配创建交换文件

swapon /mnt/swap/swapfile       //启动交换文件

genfstab -U /mnt > /mnt/etc/fstab       //设置自动挂载

cat /mnt/etc/fstab      //验证

arch-chroot /mnt        //进入系统

ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime //设置时区

hwclock --systohc       //同步硬件时钟

nvim /etc/locale.gen取消en_US.UTF-8 UTF-8和zh-CN.UTF-8 UTF-8的注释      //设置本地化

locale-gen      //生成本地化

nvim /etc/locale.conf添加LANG=en_US.UTF-8

passwd  //设置root密码

systemctl daemon-reload //安装systemd-boot

bootctl install --esp-path=/boot

cat > /boot/loader/entries/arch.conf << EOF

title   Arch Linux

linux   /vmlinuz-linux

initrd  /amd-ucode.img

initrd  /initramfs-linux.img

options root=UUID=$(blkid -s UUID -o value /dev/nvme0n1p2) rootflags=subvol=@ rw loglevel=3 quiet

EOF

cat > /boot/loader/loader.conf << EOF

default arch

timeout 3

console-mode max

editor no

EOF

systemd-machine-id-setup

bootctl update

pacman -S efibootmgr

exit

reboot

