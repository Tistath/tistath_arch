binds {

// 遵循Ctrl的效果比Shift大

        Mod+Return allow-inhibiting=false repeat=false cooldown-ms=190 { spawn "kitty"; } // 终端

        Mod+T repeat=false cooldown-ms=190 { spawn "kitty" "-e" "zsh" "-c" "htop; exec zsh"; }

        Mod+Y       repeat=false cooldown-ms=190 { spawn "kitty" "-e" "zsh" "-c" "source ~/.config/zsh/yazi-cd.zsh; yazi-cd; exec zsh"; } // yazi文件管理器
        Mod+Shift+Y repeat=false cooldown-ms=190 { spawn "kitty" "-e" "zsh" "-c" "sudo yazi; exec zsh";                                 }

        Mod+B repeat=false cooldown-ms=190 { spawn "zen-browser"; } // 火狐浏览器

        Mod+W       repeat=false cooldown-ms=190 { spawn "wechat-universal"; } // 微信
        Mod+Shift+W repeat=false cooldown-ms=190 { spawn "linuxqq";          } // QQ
        Mod+Ctrl+W  repeat=false cooldown-ms=190 { spawn "qqmusic";          } // QQ音乐

        Mod+S       repeat=false cooldown-ms=190 { spawn "steam";        } // steam
        Mod+Shift+S repeat=false cooldown-ms=190 { spawn "watt-toolkit"; } // 加速器

        Mod+D       repeat=false cooldown-ms=190 { spawn    "swaylock";                                                  } // 锁屏
        Mod+Shift+D repeat=false cooldown-ms=190 { spawn-sh "pkill swayidle || swayidle -w timeout 300 'swaylock -f' timeout 600 'niri msg action power-off-monitors' resume 'niri msg action power-on-monitors'"; } // 开关定时锁屏

        Mod+Space       repeat=false { toggle-overview; } // 窗口概览
        Mod+MouseMiddle repeat=false { toggle-overview; }

        // 功能键（Fn）
        XF86AudioRaiseVolume   allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; } // 增大音量
        XF86AudioLowerVolume   allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-";        } // 减小音量
        XF86AudioMute          allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle";        } // 开关静音
        XF86AudioMicMute       allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle";      } // 开关麦克风静音
        XF86AudioPlay          allow-when-locked=true { spawn-sh "playerctl play-pause";                              } // 播放/暂停
        XF86AudioStop          allow-when-locked=true { spawn-sh "playerctl stop";                                    } // 停止
        XF86AudioPrev          allow-when-locked=true { spawn-sh "playerctl previous";                                } // 上一首
        XF86AudioNext          allow-when-locked=true { spawn-sh "playerctl next";                                    } // 下一首
        XF86MonBrightnessUp    allow-when-locked=true { spawn    "brightnessctl" "--class=backlight" "set" "+10%";    } // 增大亮度
        XF86MonBrightnessDown  allow-when-locked=true { spawn    "brightnessctl" "--class=backlight" "set" "10%-";    } // 减小亮度
    
        // 切换聚焦窗口
        Mod+Left                                { focus-column-left;  }
        Mod+Right                               { focus-column-right; }
        Mod+Up                                  { focus-window-up;    }
        Mod+Down                                { focus-window-down;  }
        Mod+H                                   { focus-column-left;  }
        Mod+L                                   { focus-column-right; }
        Mod+K                                   { focus-window-up;    }
        Mod+J                                   { focus-window-down;  }
        Mod+Alt+WheelScrollUp   cooldown-ms=140 { focus-column-left;  }
        Mod+Alt+WheelScrollDown cooldown-ms=140 { focus-column-right; }

        Mod+Home { focus-column-first; }
        Mod+End  { focus-column-last;  }

        Mod+1 { focus-column 1;  }
        Mod+2 { focus-column 2;  }
        Mod+3 { focus-column 3;  }
        Mod+4 { focus-column 4;  }
        Mod+5 { focus-column 5;  }
        Mod+6 { focus-column 6;  }
        Mod+7 { focus-column 7;  }
        Mod+8 { focus-column 8;  }
        Mod+9 { focus-column 9;  }
        Mod+0 { focus-column 10; }

        // 移动窗口
        Mod+Shift+Left  { move-column-left;  }
        Mod+Shift+Right { move-column-right; }
        Mod+Shift+Up    { move-window-up;    }
        Mod+Shift+Down  { move-window-down;  }
        Mod+Shift+H     { move-column-left;  }
        Mod+Shift+L     { move-column-right; }
        Mod+Shift+K     { move-window-up;    }
        Mod+Shift+J     { move-window-down;  }

        Mod+Ctrl+Left  { move-column-to-first;          }
        Mod+Ctrl+Right { move-column-to-last;           }
        Mod+Ctrl+Up    { move-window-to-workspace-up;   }
        Mod+Ctrl+Down  { move-window-to-workspace-down; }
        Mod+Ctrl+H     { move-column-to-first;          }
        Mod+Ctrl+L     { move-column-to-last;           }
        Mod+Ctrl+K     { move-window-to-workspace-up;   }
        Mod+Ctrl+J     { move-window-to-workspace-down; }

        Mod+Shift+Page_Up                         { move-column-to-workspace-up;   }
        Mod+Shift+Page_Down                       { move-column-to-workspace-down; }
        Mod+Shift+O                               { move-column-to-workspace-up;   }
        Mod+Shift+I                               { move-column-to-workspace-down; }
        Mod+Shift+WheelScrollUp   cooldown-ms=140 { move-column-to-workspace-up;   }
        Mod+Shift+WheelScrollDown cooldown-ms=140 { move-column-to-workspace-down; }

        Mod+Ctrl+Home { move-column-to-first; }
        Mod+Ctrl+End  { move-column-to-last;  }

        Mod+Alt+1 { move-window-to-workspace 1;  }
        Mod+Alt+2 { move-window-to-workspace 2;  }
        Mod+Alt+3 { move-window-to-workspace 3;  }
        Mod+Alt+4 { move-window-to-workspace 4;  }
        Mod+Alt+5 { move-window-to-workspace 5;  }
        Mod+Alt+6 { move-window-to-workspace 6;  }
        Mod+Alt+7 { move-window-to-workspace 7;  }
        Mod+Alt+8 { move-window-to-workspace 8;  }
        Mod+Alt+9 { move-window-to-workspace 9;  }
        Mod+Alt+0 { move-window-to-workspace 10; }

        Mod+Ctrl+1 { move-column-to-workspace 1;  }
        Mod+Ctrl+2 { move-column-to-workspace 2;  }
        Mod+Ctrl+3 { move-column-to-workspace 3;  }
        Mod+Ctrl+4 { move-column-to-workspace 4;  }
        Mod+Ctrl+5 { move-column-to-workspace 5;  }
        Mod+Ctrl+6 { move-column-to-workspace 6;  }
        Mod+Ctrl+7 { move-column-to-workspace 7;  }
        Mod+Ctrl+8 { move-column-to-workspace 8;  }
        Mod+Ctrl+9 { move-column-to-workspace 9;  }
        Mod+Ctrl+0 { move-column-to-workspace 10; }

        // 切换聚焦工作区
        Mod+Page_Up                         { focus-workspace-up;   }
        Mod+Page_Down                       { focus-workspace-down; }
        Mod+O                               { focus-workspace-up;   }
        Mod+I                               { focus-workspace-down; }
        Mod+WheelScrollUp   cooldown-ms=140 { focus-workspace-up;   }
        Mod+WheelScrollDown cooldown-ms=140 { focus-workspace-down; }
 
        Mod+Shift+1 { focus-workspace 1;  }
        Mod+Shift+2 { focus-workspace 2;  }
        Mod+Shift+3 { focus-workspace 3;  }
        Mod+Shift+4 { focus-workspace 4;  }
        Mod+Shift+5 { focus-workspace 5;  }
        Mod+Shift+6 { focus-workspace 6;  }
        Mod+Shift+7 { focus-workspace 7;  }
        Mod+Shift+8 { focus-workspace 8;  }
        Mod+Shift+9 { focus-workspace 9;  }
        Mod+Shift+0 { focus-workspace 10; }

        // 移动工作区
        Mod+Ctrl+Page_Up                         { move-workspace-up;   }
        Mod+Ctrl+Page_Down                       { move-workspace-down; }
        Mod+Ctrl+O                               { move-workspace-up;   }
        Mod+Ctrl+I                               { move-workspace-down; }
        Mod+Ctrl+WheelScrollUp   cooldown-ms=140 { move-workspace-up;   }
        Mod+Ctrl+WheelScrollDown cooldown-ms=140 { move-workspace-down; }

        // 合并入列
        Mod+BracketLeft  { consume-or-expel-window-left;  }
        Mod+BracketRight { consume-or-expel-window-right; }

        Mod+Comma  { consume-window-into-column; } // 吸入相邻窗口
        Mod+Period { expel-window-from-column;   } // 弹出当前窗口
        
        // 调整窗口至预设大小
        Mod+R       repeat=false { switch-preset-column-width;  }
        Mod+Shift+R repeat=false { switch-preset-window-height; }

        // 最大化窗口
        Mod+F       repeat=false { maximize-column;          }
        Mod+Alt+F   repeat=false { set-window-height "100%"; }
        Mod+Shift+F repeat=false { maximize-window-to-edges; }
        Mod+Ctrl+F  repeat=false { fullscreen-window;        }

        // 居中当前/所有可见窗口/所有窗口
        Mod+C       { center-column;          }
        Mod+Shift+C { center-visible-columns; }
        Mod+Ctrl+C  { spawn-sh "niri msg action center-column; [ -s ~/.config/niri/_center-focused-column.kdl ] && : > ~/.config/niri/_center-focused-column.kdl || printf 'layout {\n        center-focused-column \"always\"\n}' > ~/.config/niri/_center-focused-column.kdl"; }

        // 调整窗口大小
        Mod+Minus       { set-column-width  "-12.5%"; }
        Mod+Equal       { set-column-width  "+12.5%"; }
        Mod+Shift+Minus { set-window-height "-12.5%"; }
        Mod+Shift+Equal { set-window-height "+12.5%"; }

        Mod+E       { set-column-width  "50%";  }
        Mod+Shift+E { set-window-height "50%"; }

        Mod+V       repeat=false cooldown-ms=190 { toggle-window-floating;                   } // 切换浮动/平铺
        Mod+Shift+V repeat=false cooldown-ms=190 { switch-focus-between-floating-and-tiling; } // 在浮动/平铺间切换聚焦

        // 切换标签页/堆叠
        Mod+Tab repeat=false cooldown-ms=190 { toggle-column-tabbed-display; }

        // 截屏
        Print           repeat=false { screenshot;                          }
        Shift+Print     repeat=false { screenshot-window;                   }
        Ctrl+Print      repeat=false { screenshot-screen;                   }
        Alt+Print       repeat=false { screenshot        show-pointer=true; }
        Alt+Shift+Print repeat=false { screenshot-window show-pointer=true; }
        Alt+Ctrl+Print  repeat=false { screenshot-screen show-pointer=true; }

        // 禁用niri快捷键
        Mod+Escape repeat=false { toggle-keyboard-shortcuts-inhibit; }

        Mod+Q allow-inhibiting=false repeat=false cooldown-ms=190 { close-window;       } // 关闭窗口
        Mod+Shift+Q                                               { power-off-monitors; } // 熄屏
        Mod+Ctrl+Q                                                { quit;               } // 退出niri
}
