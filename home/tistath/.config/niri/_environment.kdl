environment {
        LC_MESSAGES         "zh_CN.UTF-8"                  // 编码

        XMODIFIERS          "@im=fcitx"                    // X11输入法

        XDG_CURRENT_DESKTOP "niri"                         // 桌面

        XDG_SESSION_TYPE    "wayland"                      // 图形会话

        MOZ_ENABLE_WAYLAND  "1"                            // Mozilla应用使用Wayland

        EDITOR              "nvim"                         // 编辑器
        VISUAL              "nvim"                         // 可视化编辑器

        BROWSER             "zen-browser"                  // 浏览器
}
