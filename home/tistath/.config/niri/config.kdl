input {
    keyboard {           //键盘
        repeat-delay 190 //长按的延迟
        repeat-rate  20  //每秒重复的次数
        numlock          //默认启用小键盘
    }

    touchpad {          //触摸板
        tap             //点击视为左键
        natural-scroll  //自然滚动
    }

    mouse {             //鼠标
        accel-speed 0.5 //鼠标速度
    }

    trackpoint {        //指点杆
    }
}

output "eDP-1" {                //显示接口
    mode "1920x1080@60"         //屏幕参数
    scale 1                     //图标缩放
}

animations {
    workspace-switch {
        duration-ms 180
        curve "ease-out-cubic"
    }

    window-open {
        duration-ms 180
        curve "ease-out-cubic"
    }

    window-close {
        duration-ms 180
        curve "ease-out-cubic"
    }

    horizontal-view-movement {
        duration-ms 180
        curve "ease-out-cubic"
    }

    window-movement {
        duration-ms 180
        curve "ease-out-cubic"
    }

    window-resize {
        duration-ms 180
        curve "ease-out-cubic"
    }

    config-notification-open-close {
        duration-ms 180
        curve "ease-out-cubic"
    }

    exit-confirmation-open-close {
        duration-ms 180
        curve "ease-out-cubic"
    }

    screenshot-ui-open {
        duration-ms 180
        curve "ease-out-cubic"
    }

    overview-open-close {
        duration-ms 180
        curve "ease-out-cubic"
    }

    recent-windows-close {
        duration-ms 180
        curve "ease-out-cubic"
    }
}

prefer-no-csd                   //接管客户端装饰（以隐藏标题栏）

layout {
    gaps 12                     //窗口间距
                                //调整窗口大小时的可选值
    preset-column-widths {
        proportion 0.25
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 0.75
        proportion 1.0
    }

    preset-window-heights {
        proportion 0.25
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 0.75
        proportion 1.0
    }

    default-column-width {      //新窗口默认宽度
        proportion 0.5;
    }
}
                                                                                                        //自启动项
spawn-at-startup        "swaybg" "-i" "/home/tistath/Pictures/Pictures/tistath_desktop.png" "-m" "fill" //壁纸
spawn-at-startup        "waybar"                                                                        //状态栏
spawn-at-startup        "kitty" "-e" "fish" "-c" "fastfetch --config examples/6; exec fish"             //终端及fastfetch
spawn-at-startup        "fcitx5"                                                                        //输入法
spawn-at-startup        "copyq"                                                                         //剪切板
spawn-at-startup        "/usr/lib/mate-polkit/polkit-mate-authentication-agent-1"                       //权限询问
spawn-at-startup        "mako"                                                                          //消息
spawn-at-startup        "/home/tistath/.config/niri/scripts/swayidle.sh"                                //锁屏

screenshot-path         "/home/tistath/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"      //截屏路径

environment {                           //环境变量
	LC_MESSAGES "zh_CN.UTF-8"       //编码
	XMODIFIERS "@im=fcitx"          //输入法
}

cursor {                                                //鼠标指针                                               
        xcursor-theme "Colloid-Dracula-cursors-dark"    //主题
        xcursor-size 37                                 //大小
        hide-after-inactive-ms 15000                    //待机隐藏时间
}

hotkey-overlay {        //快捷键面板
    skip-at-startup     //跳过自启动
}

window-rule {                           //窗口规则
    geometry-corner-radius 12           //圆角大小
    clip-to-geometry true               //裁掉超出边框的内容
    draw-border-with-background false   //不填充背景

    focus-ring {                //聚焦窗口的边框                  
        width 1.50              //宽度
        active-color "#b4befe"  //颜色（mocha-Lavender）
    }
}

window-rule {                                                   //火狐浏览器窗口规则
    match app-id=r#"zen-browser$"# title="^Picture-in-Picture$"     //图片窗口规则
    open-floating true                                          //设为浮动窗口
}

layer-rule {                    //层级规则（渲染优先级）
    match namespace="waybar"    //状态栏层级规则
    opacity 0.8                 //透明度
}

gestures {              //手势规则
    hot-corners {       //热角规则
        off             //关闭
    }
}

binds {                                                                                                             //快捷键（遵循Ctrl的效果比Shift大）
    Mod+T     allow-inhibiting=false repeat=false { spawn    "kitty";                                             } //终端
    Mod+B                                         { spawn    "zen-browser";                                           } //火狐浏览器
    Mod+W                                         { spawn    "wechat-universal";                                  } //微信
    Mod+Shift+W                                   { spawn    "linuxqq";                                           } //QQ
    Mod+S                                         { spawn    "steam";                                             } //steam
    Mod+Shift+S                                   { spawn    "watt-toolkit";                                      } //加速器
    Mod+D                                         { spawn    "swaylock";                                          } //锁屏
    Mod+Shift+D                                   { spawn-sh "pkill swayidle || scripts/swayidle.sh";             } //开关定时锁屏
                                                                                                                    //功能键（Fn）
    XF86AudioRaiseVolume   allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; } //增大音量
    XF86AudioLowerVolume   allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-";        } //减小音量
    XF86AudioMute          allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle";        } //开关静音
    XF86AudioMicMute       allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle";      } //开关麦克风静音
    XF86AudioPlay          allow-when-locked=true { spawn-sh "playerctl play-pause";                              } //播放/暂停
    XF86AudioStop          allow-when-locked=true { spawn-sh "playerctl stop";                                    } //停止
    XF86AudioPrev          allow-when-locked=true { spawn-sh "playerctl previous";                                } //上一首
    XF86AudioNext          allow-when-locked=true { spawn-sh "playerctl next";                                    } //下一首
    XF86MonBrightnessUp    allow-when-locked=true { spawn    "brightnessctl" "--class=backlight" "set" "+10%";    } //增大亮度
    XF86MonBrightnessDown  allow-when-locked=true { spawn    "brightnessctl" "--class=backlight" "set" "10%-";    } //减小亮度

    Mod+Q     allow-inhibiting=false repeat=false {          close-window;                                        } //关闭窗口
                                                                                                                    //切换聚焦/移动窗口
    Mod+Left                                      {          focus-column-left;                                   }
    Mod+Right                                     {          focus-column-right;                                  }
    Mod+Up                                        {          focus-window-up;                                     }
    Mod+Down                                      {          focus-window-down;                                   }
    Mod+J                                         {          focus-column-left;                                   }
    Mod+semicolon                                 {          focus-column-right;                                  }
    Mod+L                                         {          focus-window-up;                                     }
    Mod+K                                         {          focus-window-down;                                   }
    Mod+Alt+WheelScrollUp                         {          focus-column-left;                                   }
    Mod+Alt+WheelScrollDown                       {          focus-column-right;                                  }

    Mod+Ctrl+Left                                 {          move-column-left;                                    }
    Mod+Ctrl+Right                                {          move-column-right;                                   }
    Mod+Ctrl+Up                                   {          move-window-up;                                      }
    Mod+Ctrl+Down                                 {          move-window-down;                                    }
    Mod+Ctrl+J                                    {          move-column-left;                                    }
    Mod+Ctrl+semicolon                            {          move-column-right;                                   }
    Mod+Ctrl+L                                    {          move-window-up;                                      }
    Mod+Ctrl+K                                    {          move-window-down;                                    }
    Mod+Ctrl+Alt+WheelScrollLeft                  {          move-column-left;                                    }
    Mod+Ctrl+Alt+WheelScrollRight                 {          move-column-right;                                   }
                                                                                                                    //切换聚焦/移动首尾窗口
    Mod+Home                                      {          focus-column-first;                                  }
    Mod+End                                       {          focus-column-last;                                   }
    Mod+Ctrl+Home                                 {          move-column-to-first;                                }
    Mod+Ctrl+End                                  {          move-column-to-last;                                 }
                                                                                                                    //切换聚焦屏幕
    Mod+Shift+Left                                {          focus-monitor-left;                                  }
    Mod+Shift+Right                               {          focus-monitor-right;                                 }
    Mod+Shift+Up                                  {          focus-monitor-up;                                    }
    Mod+Shift+Down                                {          focus-monitor-down;                                  }
    Mod+Shift+J                                   {          focus-monitor-left;                                  }
    Mod+Shift+semicolon                           {          focus-monitor-right;                                 }
    Mod+Shift+L                                   {          focus-monitor-up;                                    }
    Mod+Shift+K                                   {          focus-monitor-down;                                  }
                                                                                                                    //移动到屏幕
    Mod+Shift+Ctrl+Left                           {          move-column-to-monitor-left;                         }
    Mod+Shift+Ctrl+Right                          {          move-column-to-monitor-right;                        }
    Mod+Shift+Ctrl+Up                             {          move-column-to-monitor-up;                           }
    Mod+Shift+Ctrl+Down                           {          move-column-to-monitor-down;                         }
    Mod+Shift+Ctrl+J                              {          move-column-to-monitor-left;                         }
    Mod+Shift+Ctrl+semicolon                      {          move-column-to-monitor-right;                        }
    Mod+Shift+Ctrl+L                              {          move-column-to-monitor-up;                           }
    Mod+Shift+Ctrl+K                              {          move-column-to-monitor-down;                         }
                                                                                                                    //切换聚焦/移动工作区
    Mod+Page_Up                                   {          focus-workspace-up;                                  }
    Mod+Page_Down                                 {          focus-workspace-down;                                }
    Mod+O                                         {          focus-workspace-up;                                  }
    Mod+I                                         {          focus-workspace-down;                                }
    Mod+WheelScrollUp             cooldown-ms=150 {          focus-workspace-up;                                  } //冷却
    Mod+WheelScrollDown           cooldown-ms=150 {          focus-workspace-down;                                }
    Mod+Ctrl+Page_Up                             {          move-workspace-up;                                   }
    Mod+Ctrl+Page_Down                           {          move-workspace-down;                                 }
    Mod+Ctrl+O                                   {          move-workspace-up;                                   }
    Mod+Ctrl+I                                   {          move-workspace-down;                                 }
    Mod+Ctrl+WheelScrollUp                       {          move-workspace-up;                                   }
    Mod+Ctrl+WheelScrollDown                     {          move-workspace-down;                                 }
                                                                                                                    //移动到工作区
    Mod+Shift+Page_Up                              {          move-column-to-workspace-up;                         }
    Mod+Shift+Page_Down                            {          move-column-to-workspace-down;                       }
    Mod+Shift+O                                    {          move-column-to-workspace-up;                         }
    Mod+Shift+I                                    {          move-column-to-workspace-down;                       }
    Mod+Shift+WheelScrollUp        cooldown-ms=150 {          move-column-to-workspace-up;                         }
    Mod+Shift+WheelScrollDown      cooldown-ms=150 {          move-column-to-workspace-down;                       }
                                                                                                                    //切换聚焦工作区
    Mod+1                                         {          focus-workspace 1;                                   }
    Mod+2                                         {          focus-workspace 2;                                   }
    Mod+3                                         {          focus-workspace 3;                                   }
    Mod+4                                         {          focus-workspace 4;                                   }
    Mod+5                                         {          focus-workspace 5;                                   }
    Mod+6                                         {          focus-workspace 6;                                   }
    Mod+7                                         {          focus-workspace 7;                                   }
    Mod+8                                         {          focus-workspace 8;                                   }
    Mod+9                                         {          focus-workspace 9;                                   }
    Mod+0                                         {          focus-workspace 10;                                  }
                                                                                                                    //移动到工作区
    Mod+Ctrl+1                                    {          move-column-to-workspace 1;                          }
    Mod+Ctrl+2                                    {          move-column-to-workspace 2;                          }
    Mod+Ctrl+3                                    {          move-column-to-workspace 3;                          }
    Mod+Ctrl+4                                    {          move-column-to-workspace 4;                          }
    Mod+Ctrl+5                                    {          move-column-to-workspace 5;                          }
    Mod+Ctrl+6                                    {          move-column-to-workspace 6;                          }
    Mod+Ctrl+7                                    {          move-column-to-workspace 7;                          }
    Mod+Ctrl+8                                    {          move-column-to-workspace 8;                          }
    Mod+Ctrl+9                                    {          move-column-to-workspace 9;                          }
    Mod+Ctrl+0                                    {          move-column-to-workspace 10;                         }
                                                                                                                    //合并入列
    Mod+BracketLeft                               {          consume-or-expel-window-left;                        }
    Mod+BracketRight                              {          consume-or-expel-window-right;                       }

    Mod+Comma                                     {          consume-window-into-column;                          } //吸入相邻窗口
    Mod+Period                                    {          expel-window-from-column;                            } //弹出当前窗口
                                                                                                                    //调整窗口至预设大小
    Mod+R                                         {          switch-preset-column-width;                          }
    Mod+Shift+R                                   {          switch-preset-window-height;                         }
                                                                                                                    //最大化窗口
    Mod+F                                         {          maximize-column;                                     }
    Mod+Shift+F                                   {          maximize-window-to-edges;                            }
    Mod+Ctrl+F                                    {          fullscreen-window;                                   }
                                                                                                                    //居中当前/所有窗口
    Mod+C                                         {          center-column;                                       }
    Mod+Shift+C                                   {          center-visible-columns;                              }
                                                                                                                    //调整窗口大小
    Mod+Minus                                     {          set-column-width "-10%";                             }
    Mod+Equal                                     {          set-column-width "+10%";                             }
    Mod+Shift+Minus                               {          set-window-height "-10%";                            }
    Mod+Shift+Equal                               {          set-window-height "+10%";                            }

    Mod+V                                         {          toggle-window-floating;                              } //切换浮动/平铺
    Mod+Shift+V                                   {          switch-focus-between-floating-and-tiling;            } //在浮动/平铺间切换聚焦
                                                                                                                    //截屏
    Print                                         {          screenshot;                                          }
    Ctrl+Print                                    {          screenshot-screen;                                   }
    Shift+Print                                   {          screenshot-window;                                   }
                                                                                                                    //禁用niri快捷键
    Mod+Escape                                    {          toggle-keyboard-shortcuts-inhibit;                   }
                                                                                                                    //熄屏
    Mod+Shift+Q                                   {          power-off-monitors;                                  }
                                                                                                                    //退出niri
    Mod+Ctrl+Q                                    {          quit;                                                }
                                                                                                                    //切换标签页/堆叠
    Mod+Tab                                       {          toggle-column-tabbed-display;                        }
}
