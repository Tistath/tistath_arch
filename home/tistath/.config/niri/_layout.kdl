layout {
    gaps 12                // 窗口间距
                           // 调整窗口大小时的可选值
    preset-column-widths {
        proportion 0.25
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 0.75
        proportion 1.0
    }

    preset-window-heights {
        proportion 0.25
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 0.75
        proportion 1.0
    }

    default-column-width { // 新窗口默认宽度
        proportion 1.0;
    }
}
