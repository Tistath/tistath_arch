layout {
        gaps 12                // 窗口间距
                               // 调整窗口大小时的可选值
        preset-column-widths {
                proportion 0.25
                proportion 0.5
                proportion 0.75
                proportion 1.0
        }

        preset-window-heights {
                proportion 0.25
                proportion 0.5
                proportion 0.75
                proportion 1.0
        }

        default-column-width { // 新窗口默认宽度
                proportion 0.5;
        }

        focus-ring {                   // 聚焦窗口的边框
                width 3.00             // 宽度
                active-color "#b4befe" // 颜色（mocha-Pink）
        }
}
