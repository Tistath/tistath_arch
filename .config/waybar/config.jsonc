{
    "include": [
        "modules.jsonc",
        "modules-dividers.jsonc"
    ],
    "layer": "top",
    "position": "top",
    "fixed-center": true,
    "reload_style_on_change": true,
    "modules-left": [
        "niri/workspaces",
        "custom/right_div#SurfaceSurfacecontainerhigh",
        "custom/right_div#Surfacecontainerhigh"
    ],
    "modules-center": [
        "custom/left_div#Surfacecontainerhigh",
        "custom/left_div#TertiarySurfacecontainerhigh",
        "clock#date",
        "custom/left_div#SurfacecontainerTertiary",
        "custom/left_div#PrimarySurfacecontainer",
        "custom/applauncher",
        "custom/right_div#PrimarySurfacecontainer",
        "custom/right_div#SurfacecontainerSecondary",
        "clock",
        "custom/right_div#SecondarySurfacecontainerhigh",
        "custom/right_div#Surfacecontainerhigh"
    ],
    "modules-right": [
        "custom/left_div#Surfacecontainerhigh",
        "tray",
        "custom/left_div#SurfacecontainerSurfacecontainerhigh",
        "network",
        "battery",
        "custom/left_div#SurfaceSurfacecontainer",
        "group/powermenu"
    ]
}
