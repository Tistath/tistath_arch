[user]
	# 提交作者名
	name  = Tistath
	# 提交作者邮箱
	email = eta_gamma_omega@qq.com

[init]
	# 默认分支
	defaultBranch = main

[core]
	# 默认编辑器
	editor    = nvim
	# 分页器
	pager     = delta
	# 提交转LF，检出不转（Linux）
	autocrlf  = input
	# 不转义中文文件名
	quotepath = false

[interactive]
	# diff用delta
	diffFilter = delta --color-only

[delta "catppuccin-mocha"]
	blame-palette = "#1e1e2e #181825 #11111b #313244 #45475a"
	commit-decoration-style = "#6c7086" bold box ul
	dark = true
	file-decoration-style = "#6c7086"
	file-style = "#cdd6f4"
	hunk-header-decoration-style = "#6c7086" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#a6adc8"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#6c7086"
	line-numbers-minus-style = bold "#f38ba8"
	line-numbers-plus-style = bold "#a6e3a1"
	line-numbers-right-style = "#6c7086"
	line-numbers-zero-style = "#6c7086"
	# 35% red 65% base
	minus-emph-style = bold syntax "#694559"
	# 20% red 80% base
	minus-style = syntax "#493447"
	# 35% green 65% base
	plus-emph-style = bold syntax "#4e6356"
	# 20% green 80% base
	plus-style = syntax "#394545"
	map-styles = \
		bold purple => syntax "#5b4e74", \
		bold blue => syntax "#445375", \
		bold cyan => syntax "#446170", \
		bold yellow => syntax "#6b635b"
	# Should match the name of the bat theme
	syntax-theme = Catppuccin Mocha

[delta]
	# 显示行号
	line-numbers                 = true
	# 单列
	side-by-side                 = false
	# 启用主题
	features                     = catppuccin-mocha
[merge]
        # 冲突显示（base/ours/theirs）
        conflictstyle = diff3
        # 启用主题
        features      = catppuccin-mocha

[diff]
	# 移动的代码用不同色
	colorMoved = default
	# 比默认myers好
	algorithm  = histogram

[alias]
	# 简短状态
	st      = status -sb
	# 切换分支
	co      = checkout
	# 分支列表
	br      = branch
	# 提交
	ci      = commit
	# 图形化log
	lg      = log --oneline --graph --decorate --all
	# 最后一次提交
	last    = log -1 HEAD
	# 取消暂存
	unstage = reset HEAD --
	# 撤销上次提交，保留改动
	undo    = reset --soft HEAD~1
	# 修改上次提交，不改消息
	amend   = commit --amend --no-edit
	# 安全强推
	pushf   = push --force-with-lease
	# diff
	df      = diff
	# 暂存区diff
	dfs     = diff --staged
	# diff统计
	ds      = diff --stat
	# 删已合并到main/master的分支
	cleanup = "!git branch --merged | grep -v '\\*\\|main\\|master' | xargs -r git branch -d"

[color]
	# 自动颜色
	ui = auto

[pull]
	# pull用merge
	rebase = false

[push]
	# 只推当前分支
	default         = simple
	# push自动-u
	autoSetupRemote = true

[fetch]
	# 自动删远程已删分支
	prune = true
