// 输入设备
include         "config/input.kdl"

// 输出设备
include         "config/output.kdl"

// 快捷键
include         "config/binds.kdl"

//布局
include         "config/layout.kdl"

// 全局居中聚焦切换
include         "config/center-focused-column.kdl"

// 自启动项
include         "config/spawn-at-startup.kdl"

// 接管客户端装饰（以隐藏标题栏）
prefer-no-csd

// 截屏路径
screenshot-path "~/Pictures/Screenshots/Screenshot-%y-%m-%d-%H-%M-%S.png"

// 环境变量
include         "config/environment.kdl"

// 鼠标指针
include         "config/cursor.kdl"

// 窗口概览
include         "config/overview.kdl"

// 快捷键面板
include         "config/hotkey-overlate.kdl"

// 窗口规则
include         "config/window-rule.kdl"

// 层级规则
include         "config/layer-rule.kdl"

// 动画
include         "config/animations.kdl"

// 手势规则
include         "config/gestures.kdl"
